{
  "manifest_version": 3,
  "name": "Drink",
  "version": "2.0.2",
  "description": "“Drink” is a Chrome extension that helps you stay hydrated as you work in the browser.",
  "permissions": ["alarms", "storage", "notifications"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Drink — Water Reminder"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bottles/*", "icons/sip-icon-*.png", "icons/sip-icon-dark-*.png", "fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/sip-icon-16.png",
    "32": "icons/sip-icon-32.png",
    "48": "icons/sip-icon-64.png",
    "128": "icons/sip-icon-128.png"
  }
}
