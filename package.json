{
  "name": "sip",
  "version": "2.0.2",
  "description": "“Drink” is a Chrome extension that helps you stay hydrated as you work in the browser.",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "sync-dark-tokens": "node scripts/sync-dark-tokens.js",
    "check-tokens": "node scripts/sync-dark-tokens.js --check",
    "release": "node scripts/release.js",
    "gen-icons": "node scripts/gen-icons.js",
    "cws:auth": "node scripts/cws-auth.js",
    "cws:publish": "node scripts/publish.js"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
